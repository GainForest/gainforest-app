# GainForest landing — environment variables
#
# Copy to .env.local. Required-then-optional order.

# ─── ATProto OAuth (required for /api/oauth/login → callback flow) ──────
#
# Public origin used to build the OAuth client_id and redirect_uri.
# Loopback dev MUST use 127.0.0.1, not localhost — the ATProto loopback
# spec rewrites localhost → 127.0.0.1 inside the SDK and a mismatch
# breaks the callback.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3030

# Private JWKS used to sign client-assertion JWTs. Generate via:
#   node scripts/generate-jwk.mjs >> .env.local
# The script prints the matching public JWK for reference; /jwks.json
# strips the 'd' (private) component and serves the rest.
# ATPROTO_JWK_PRIVATE='{"keys":[…]}'

# ─── Capybara companion chat (powers /api/sim-chat) ─────────────────────
# OpenRouter API key. Without this the chat panel in the FloatingCapybara
# returns a friendly 503. Get one at https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# DEFAULT_CHAT_MODEL=google/gemini-2.5-flash

# ─── Live data sources (optional — sensible defaults below) ─────────────
# Defaults to api.hi.gainforest.app; override if needed:
# NEXT_PUBLIC_INDEXER_URL=https://api.hi.gainforest.app/graphql
# NEXT_PUBLIC_HYPERLABEL_URL=https://hyperlabel-production.up.railway.app
# NEXT_PUBLIC_BUMICERTS_URL=https://certs.gainforest.app
# NEXT_PUBLIC_GREEN_GLOBE_URL=https://data.gainforest.app

# ─── Legacy ─────────────────────────────────────────────────────────────
# Only used if you swap <LiveGlobe> back to a Mapbox renderer.
# Get a token at https://account.mapbox.com/access-tokens/
# NEXT_PUBLIC_MAPBOX_TOKEN=
